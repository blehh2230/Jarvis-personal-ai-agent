# =====================================================================
# JARVIS Environment Configuration
# =====================================================================

# Groq API Key for LLaMA-3.3 planning & execution (optional, fallback sandbox active if omitted)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=

# Groq Model (defaults to llama-3.3-70b-versatile or openai/gpt-oss-20b)
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily API Key for live web research & source verification (optional)
# Get a free key at: https://tavily.com
TAVILY_API_KEY=